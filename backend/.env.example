DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/ai_shopping_analyzer
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ROOT_USER=...
MINIO_ROOT_PASSWORD=...
MINIO_BUCKET=receipts

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Image settings
IMAGE_URL_TTL_SECONDS=300
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_PIXELS=20000000
# Optional receipt timezone; without it local time remains in parsing_report.
# PARSING_TIMEZONE=Asia/Omsk
# PARSING_TOTAL_TOLERANCE=0.05

# Analytics period settings
# ANALYTICS_TIMEZONE=Asia/Omsk
# ANALYTICS_MAX_PERIOD_DAYS=366

# Local LLM settings; Docker uses http://host.docker.internal:11434
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=qwen3.5:4b
# HTTP timeout per I/O operation; at most two retries with backoff
LLM_TIMEOUT_SECONDS=90
LLM_CONNECT_TIMEOUT_SECONDS=3
LLM_RETRY_INTERVALS_SECONDS=[1,3]
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_THINK=false
LLM_KEEP_ALIVE_SECONDS=300
